#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    song_table_format: [
        (
            prop: (kind: Property(Artist), default: (kind: Text("Unknown"))),
            label: "Artist",
            width: "20%",
        ),
        (
            prop: (kind: Property(Title), default: (kind: Text("Unknown"))),
            label: "Title",
            width: "35%",
        ),
        (
            prop: (
                kind: Property(Album),
                style: (fg: "white"),
                default: (kind: Text("Unknown Album"), style: (fg: "white")),
            ),
            label: "Album",
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration), default: (kind: Text("-"))),
            label: "Duration",
            width: "15%",
            alignment: Right,
        ),
        // Hidden sort key for the sm binding.
        (
            prop: (kind: Property(LastModified())),
            label: "",
            width: "0",
        ),
    ],
)
